# =====================================================================
# ANOVI HAUTE JOAILLERIE — PRODUCTION ENVIRONMENT CONFIGURATION
# =====================================================================

# Server Port (Default: 3000)
PORT=3000

# ---------------------------------------------------------------------
# 1. RAZORPAY PAYMENT GATEWAY (SECURITY-CRITICAL)
# ---------------------------------------------------------------------
# Razorpay Public Key ID (Required for frontend modal initiation)
# E.g. rzp_test_... for sandbox or rzp_live_... for production
VITE_RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"
RAZORPAY_KEY_ID="rzp_test_YOUR_KEY_ID"

# Razorpay Key Secret (SERVER-SIDE ONLY — NEVER EXPOSE IN CLIENT BUNDLE)
# Required for server-side HMAC-SHA256 signature verification & Orders API
RAZORPAY_KEY_SECRET="YOUR_RAZORPAY_KEY_SECRET"

# Razorpay Webhook Secret (Configured in Razorpay Dashboard > Webhooks)
RAZORPAY_WEBHOOK_SECRET="YOUR_RAZORPAY_WEBHOOK_SECRET"

# ---------------------------------------------------------------------
# 2. SUPABASE POSTGRESQL & STORAGE INTEGRATION
# ---------------------------------------------------------------------
# Supabase Project URL (e.g. https://your-project.supabase.co)
SUPABASE_URL="https://your-project.supabase.co"

# Supabase Anon Key (Safe for client read access with RLS enabled)
SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# Supabase Service Role Key (SERVER-SIDE ONLY — NEVER EXPOSE TO CLIENT)
# Bypasses RLS for secure server-side order and inventory reconciliation
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9..."

# ---------------------------------------------------------------------
# 3. ATELIER ADMIN AUTHENTICATION
# ---------------------------------------------------------------------
ADMIN_SECRET_KEY="ANOVI_ATELIER_SECRET_2026"

# ---------------------------------------------------------------------
# 4. OPTIONAL AI & HOSTING CONFIGURATION
# ---------------------------------------------------------------------
# GEMINI_API_KEY: Required if AI Studio concierge or generative assists are active
GEMINI_API_KEY=""

# APP_URL: Production origin URL (e.g. https://anovi-jewels.com)
APP_URL="http://localhost:3000"
